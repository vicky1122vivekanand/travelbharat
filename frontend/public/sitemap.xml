<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for TravelBharat's top-level routes. This scaffold is a
  client-rendered SPA, so for full SEO benefit in production, generate this
  file dynamically at build/deploy time by iterating /api/states and
  /api/places and emitting a <url> entry per state and destination page.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>/states</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>/explore</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>/toolkit</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>/for-students</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>/about</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
  <url><loc>/emergency</loc><changefreq>monthly</changefreq><priority>0.4</priority></url>
</urlset>
